    "Places Bower is keeping for windows that closed, or whose app quit. They go back there when they open again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Plätze, die Bower für geschlossene Fenster oder beendete Apps freihält. Die Fenster kehren dorthin zurück, wenn sie wieder geöffnet werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lugares que Bower reserva para las ventanas que se cerraron o cuya app se cerró. Vuelven ahí cuando se abren de nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "جاهایی که Bower برای پنجره‌های بسته‌شده، یا پنجره‌هایی که برنامه‌شون بسته شده، نگه داشته. وقتی دوباره باز بشن برمی‌گردن همون‌جا."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Emplacements que Bower réserve aux fenêtres fermées ou dont l’app a été quittée. Elles y retournent quand elles se rouvrent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Posti che Bower tiene da parte per le finestre chiuse o la cui app è stata chiusa. Ci tornano quando si riaprono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じたウインドウや、アプリが終了したウインドウのためにBowerが確保している場所です。再び開いたときにそこに戻ります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lugares que o Bower guarda para janelas que foram fechadas ou cujo app foi encerrado. Elas voltam para lá quando abrem de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Bower 为已关闭的窗口或应用已退出的窗口保留的位置。它们再次打开时会回到那里。"
          }
        }
      }
    },
