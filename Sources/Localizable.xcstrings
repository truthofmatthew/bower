    "Arrangement follows System Settings. Click a display to edit it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anordnung folgt den Systemeinstellungen. Klicke auf ein Display, um es zu bearbeiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La distribución sigue los Ajustes del Sistema. Haz clic en una pantalla para editarla."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ترتیب نمایشگرها همونیه که تو System Settings چیدی. رو هر نمایشگر بزن تا عوضش کنی."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’agencement suit Réglages Système. Cliquez sur un écran pour le modifier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La disposizione segue Impostazioni di Sistema. Fai clic su uno schermo per modificarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "配置はシステム設定に従います。ディスプレイをクリックして編集します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A disposição segue os Ajustes do Sistema. Clique em uma tela para editá-la."
          }
        }
      }
    },
