    "Your two front windows share the screen, half each.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine beiden vorderen Fenster teilen sich den Bildschirm, je zur Hälfte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus dos ventanas de delante se reparten la pantalla, la mitad cada una."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دو تا پنجره‌ی جلویی صفحه رو نصف نصف می‌کنن."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos deux fenêtres de premier plan se partagent l’écran, moitié chacune."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le due finestre in primo piano si dividono lo schermo, metà ciascuna."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手前の2つのウインドウが画面を半分ずつ使います。"
          }
        },
        "pt-BR": {
