    "When an app in a layout isn't running": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn eine App im Layout nicht geöffnet ist"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando una app de una disposición no se está ejecutando"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "وقتی یه برنامه‌ی چیدمان باز نیست"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand une app d’une disposition n’est pas ouverte"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando un'app di un layout non è in esecuzione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レイアウト内のアプリが実行されていないとき"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando um app de um layout não está em execução"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "布局中的应用未运行时"
          }
        }
      }
    },
    "When the Desktop is hidden in this layout.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn der Schreibtisch in diesem Layout ausgeblendet ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando el Escritorio está oculto en esta disposición."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "وقتی دسکتاپ تو این چیدمان قایمه."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand le Bureau est masqué dans cette disposition."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando la Scrivania è nascosta in questo layout."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このレイアウトでデスクトップが隠れているとき。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando a Mesa está oculta neste layout."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当此布局中隐藏桌面时。"
          }
        }
      }
    },
    "While Bower arranges your windows, they move or hide windows behind its back. You can turn them back on any time.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Während Bower deine Fenster anordnet, bewegen oder verstecken diese Funktionen Fenster hinter seinem Rücken. Du kannst sie jederzeit wieder einschalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras Bower organiza tus ventanas, estas funciones mueven u ocultan ventanas a sus espaldas. Puedes volver a activarlas cuando quieras."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "وقتی Bower داره پنجره‌هات رو می‌چینه، اینا پشت سرش پنجره‌ها رو جابه‌جا یا قایم می‌کنن. هر وقت خواستی می‌تونی دوباره روشنشون کنی."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendant que Bower agence vos fenêtres, elles déplacent ou masquent des fenêtres dans son dos. Vous pouvez les réactiver à tout moment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mentre Bower dispone le finestre, queste funzioni spostano o nascondono finestre a sua insaputa. Puoi riattivarle in qualsiasi momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bowerがウインドウを整列している間に、裏でウインドウを動かしたり隠したりします。いつでもオンに戻せます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enquanto o Bower organiza suas janelas, estes recursos movem ou ocultam janelas pelas costas dele. Você pode reativá-los quando quiser."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当 Bower 排列你的窗口时，它们会在背后移动或隐藏窗口。你可以随时重新开启它们。"
          }
        }
      }
    },
