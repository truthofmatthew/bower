        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هنوز فضای کاری ذخیره نکردی. با «ذخیره‌ی فضای کار فعلی» (⁦⌃⌥S⁩) همین چینش رو نگه دار."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun espace de travail enregistré. Utilisez Enregistrer l’espace de travail actuel (⌃⌥S) pour conserver cet agencement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
