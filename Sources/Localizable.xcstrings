    "Saves %@, %@ and window positions for %@. Windows aren't closed or moved.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichert %1$@, %2$@ und die Fensterpositionen für %3$@. Fenster werden weder geschlossen noch bewegt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Saves %1$@, %2$@ and window positions for %3$@. Windows aren't closed or moved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda %1$@, %2$@ y las posiciones de las ventanas de %3$@. Las ventanas no se cierran ni se mueven."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "‏⁨%1$@⁩، ⁨%2$@⁩ و جای پنجره‌ها رو برای ⁨%3$@⁩ ذخیره می‌کنه. پنجره‌ها نه بسته می‌شن نه جابه‌جا."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre %1$@, %2$@ et la position des fenêtres pour %3$@. Les fenêtres ne sont ni fermées ni déplacées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva %1$@, %2$@ e le posizioni delle finestre per %3$@. Le finestre non vengono chiuse né spostate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@、%2$@、および%3$@のウインドウ位置を保存します。ウインドウを閉じたり移動したりはしません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva %1$@, %2$@ e as posições das janelas de %3$@. As janelas não são fechadas nem movidas."
          }
        }
      }
    },
