    "Moves the window to the middle of the screen, same size.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schiebt das Fenster in die Bildschirmmitte, gleiche Größe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mueve la ventana al centro de la pantalla, con el mismo tamaño."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پنجره رو با همون اندازه می‌بره وسط صفحه."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Place la fenêtre au milieu de l’écran, même taille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Porta la finestra al centro dello schermo, stessa dimensione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイズはそのままでウインドウを画面中央に移します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Move a janela para o meio da tela, no mesmo tamanho."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将窗口移到屏幕中央，大小不变。"
          }
        }
      }
    },
    "Moves the window to your next display, keeping its place.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schiebt das Fenster auf den nächsten Bildschirm, an dieselbe Stelle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lleva la ventana a tu siguiente pantalla, en el mismo sitio."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پنجره رو می‌بره صفحه‌ی بعدی، همون جای قبلی."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie la fenêtre sur l’écran suivant, au même endroit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sposta la finestra sullo schermo successivo, nella stessa posizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置を保ったまま、ウインドウを次のディスプレイに移します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Leva a janela para a próxima tela, no mesmo lugar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将窗口移到下一台显示器，位置保持不变。"
          }
        }
      }
    },
    "Moving between layouts": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwischen Layouts wechseln"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Moverse entre disposiciones"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "جابه‌جایی بین چیدمان‌ها"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passer d’une disposition à l’autre"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spostarsi tra i layout"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レイアウト間の移動"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mover entre layouts"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在布局之间切换"
          }
        }
      }
    },
    "Moving between layouts now takes the swipe from macOS instead of both happening. Hold fn for macOS's own.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Wechsel zwischen Layouts übernimmt jetzt die Streichgeste von macOS, statt dass beides passiert. Halte fn für die Geste von macOS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Moverse entre disposiciones ahora toma el gesto de macOS en lugar de que ocurran ambos. Mantén fn para el de macOS."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حالا جابه‌جایی بین چیدمان‌ها سوایپ رو از macOS می‌گیره و دیگه هر دوتاش با هم اتفاق نمی‌افته. برای کار خود macOS، fn رو نگه دار."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le passage d’une disposition à l’autre reprend maintenant le balayage à macOS, au lieu que les deux se produisent. Maintenez fn pour celui de macOS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ora lo spostamento tra i layout prende lo scorrimento a macOS, invece di far succedere entrambe le cose. Tieni premuto fn per quello di macOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レイアウト間の移動がmacOSのスワイプより優先されるようになり、両方が同時に起きることはなくなりました。macOS本来の動作はfnを押したまま。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mover entre layouts agora toma o gesto do macOS em vez de os dois acontecerem. Segure fn para o do próprio macOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在在布局之间切换会接管 macOS 的轻扫手势，二者不再同时发生。按住 fn 使用 macOS 自带功能。"
          }
        }
      }
    },
