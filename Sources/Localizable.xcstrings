            "state": "translated",
            "value": "پنجره صفحه رو پر می‌کنه ولی یه کم فاصله دورش می‌مونه."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La fenêtre remplit l’écran avec une petite marge autour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La finestra riempie lo schermo con un piccolo margine intorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "周りに少し余白を残して、ウインドウが画面に広がります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A janela ocupa a tela com uma pequena margem em volta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口填满屏幕，四周留出少许边距。"
          }
        }
      }
    },
    "The window fills the screen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Fenster füllt den Bildschirm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ventana ocupa toda la pantalla."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پنجره کل صفحه رو پر می‌کنه."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La fenêtre remplit l’écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La finestra riempie lo schermo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウが画面いっぱいに広がります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A janela ocupa a tela inteira."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口填满屏幕。"
          }
        }
      }
    },
    "Their content stretches with them until they redraw at their new size. Otherwise it keeps its size, revealed or cropped.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Inhalt wird mitgestreckt, bis sie in der neuen Größe neu gezeichnet sind. Sonst behält er seine Größe und wird freigelegt oder beschnitten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su contenido se estira con ellas hasta que se redibujan con su nuevo tamaño. Si no, mantiene su tamaño, descubierto o recortado."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "محتواشون هم باهاشون کش میاد تا با اندازه‌ی جدید دوباره کشیده شن. وگرنه اندازه‌ش ثابت می‌مونه و یا دورش خالی پیدا می‌شه یا بریده می‌شه."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Leur contenu s’étire avec elles jusqu’à ce qu’elles se redessinent à leur nouvelle taille. Sinon, il garde sa taille, révélé ou rogné."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il loro contenuto si allunga con loro finché non si ridisegnano alla nuova dimensione. Altrimenti mantiene la sua dimensione, scoperto o ritagliato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいサイズで再描画されるまで、内容もいっしょに伸縮します。オフのときは内容のサイズはそのままで、余白が見えたり切れたりします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O conteúdo estica junto até ser redesenhado no novo tamanho. Caso contrário, mantém o tamanho, revelado ou cortado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口内容会随之拉伸，直到按新尺寸重绘。否则内容保持原尺寸，露出或被裁切。"
          }
        }
      }
    },
    "There and back.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hin und zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ida y vuelta."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "رفت و برگشت."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aller-retour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Andata e ritorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "行って戻りました。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ida e volta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "去了又回。"
          }
        }
      }
    },
    "These macOS features move windows behind Bower's back. You can turn them back on in Settings › General.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese macOS-Funktionen verschieben Fenster an Bower vorbei. Du kannst sie unter Einstellungen › Allgemein wieder einschalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas funciones de macOS mueven ventanas a espaldas de Bower. Puedes volver a activarlas en Ajustes › General."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این قابلیت‌های macOS پشت سر باوِر پنجره‌ها رو جابه‌جا می‌کنن. هر وقت خواستی تو تنظیمات › عمومی دوباره روشنشون کن."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces fonctions de macOS déplacent les fenêtres dans le dos de Bower. Vous pouvez les réactiver dans Réglages › Général."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Queste funzioni di macOS spostano le finestre alle spalle di Bower. Puoi riattivarle in Impostazioni › Generali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのmacOSの機能はBowerの知らないうちにウインドウを動かします。設定 › 一般でいつでも元に戻せます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estes recursos do macOS movem janelas sem o Bower saber. Você pode reativá-los em Ajustes › Geral."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些 macOS 功能会绕过 Bower 移动窗口。你可以随时在设置 › 通用中重新打开它们。"
          }
        }
      }
    },
    "These would fight Bower": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese würden mit Bower kollidieren"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas chocarían con Bower"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اینا با Bower دعوا دارن"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces fonctions entreraient en conflit avec Bower"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Queste litigherebbero con Bower"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bowerとぶつかる機能"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estes brigariam com o Bower"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些会与 Bower 冲突"
          }
        }
      }
    },
    "They float freely and are never arranged, in any mode.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie schweben frei und werden in keinem Modus angeordnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Flotan libremente y nunca se organizan, en ningún modo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آزادانه شناورن و تو هیچ حالتی چیده نمی‌شن."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elles flottent librement et ne sont jamais agencées, quel que soit le mode."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fluttuano liberamente e non vengono mai disposte, in nessuna modalità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのモードでも整列されず、自由にフロートします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Elas flutuam livremente e nunca são organizadas, em nenhum modo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它们自由浮动，在任何模式下都不会被排列。"
          }
        }
      }
    },
    "Thirds": {
      "localizations": {
        "de": {
