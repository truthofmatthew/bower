    "Puts the window back where it was before Bower last moved it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bringt das Fenster dorthin zurück, wo es war, bevor Bower es zuletzt bewegt hat."
          }
        },
        "es": {
          "stringUnit": {
