    "Off: the middle button goes to apps as usual.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus: Die mittlere Maustaste geht wie gewohnt an die Apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado: el botón central llega a las apps como siempre."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "خاموش: دکمه‌ی وسط مثل همیشه می‌ره سراغ برنامه‌ها."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé : le bouton du milieu fonctionne normalement dans les apps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivato: il tasto centrale viene inviato alle app come di consueto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフ：中ボタンは通常どおりアプリに渡されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado: o botão do meio vai para os apps normalmente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭：中键照常传给应用。"
          }
        }
      }
    },
    "Off: windows from other layouts stay where they are, behind.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus: Fenster aus anderen Layouts bleiben, wo sie sind – im Hintergrund."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado: las ventanas de otras disposiciones se quedan donde están, detrás."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "خاموش: پنجره‌های چیدمان‌های دیگه همون پشت، سر جاشون می‌مونن."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé : les fenêtres des autres dispositions restent où elles sont, en arrière-plan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivato: le finestre degli altri layout restano dove sono, sullo sfondo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフ：ほかのレイアウトのウインドウは背面のその場所に残ります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado: janelas de outros layouts ficam onde estão, atrás."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭：其他布局的窗口留在原处，位于后面。"
          }
        }
      }
    },
