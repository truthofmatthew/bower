    "Lets the overview show what's in your windows. Still pictures only, never recorded or kept.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit zeigt die Übersicht, was in deinen Fenstern ist. Nur Standbilder, nie aufgezeichnet oder gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que la vista general muestre lo que hay en tus ventanas. Solo imágenes fijas, nunca grabadas ni guardadas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نمای کلی می‌تونه محتوای پنجره‌هات رو نشون بده. فقط عکس ثابت؛ نه ضبط می‌شه، نه نگه داشته می‌شه."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet à la vue d'ensemble de montrer le contenu de vos fenêtres. Des images fixes, jamais enregistrées ni conservées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Permette alla panoramica di mostrare cosa c'è nelle tue finestre. Solo immagini fisse, mai registrate né conservate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オーバービューにウインドウの中身を表示できます。静止画のみで、録画も保存もしません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que a visão geral mostre o que há nas suas janelas. Só imagens estáticas, nunca gravadas nem guardadas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让总览显示窗口里的内容。只是静态画面，从不录制或保存。"
          }
        }
      }
    },
