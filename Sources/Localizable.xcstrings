    "%@ with a number is %@. Change that first.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ mit einer Zahl ist %2$@. Ändere das zuerst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ with a number is %2$@. Change that first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ con un número es %2$@. Cambia eso primero."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "‏⁨%1$@⁩ با یه عدد، الان مال ⁨%2$@⁩ هست. اول اونو عوض کن."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ avec un chiffre correspond à %2$@. Modifiez d’abord ce raccourci."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ con un numero è %2$@. Cambia prima quella."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数字付きの%1$@は%2$@に使われています。先にそちらを変更してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ com um número é %2$@. Mude isso primeiro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 加数字已用于 %2$@。请先更改那个。"
          }
        }
      }
    },
    "%@ · arrows move, Return runs": {
