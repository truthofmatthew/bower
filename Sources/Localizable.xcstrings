        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bower est désactivé sur ce bureau. Activez-le dans Cet écran › Utiliser Bower sur ce bureau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bower è disattivato su questa scrivania. Attivalo in Questo schermo › Usa Bower su questa scrivania."
          }
        },
        "ja": {
