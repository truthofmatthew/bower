            "state": "translated",
            "value": "Beschreibe den gewünschten Schreibtisch und klicke dann auf „Vorschau“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe el escritorio que quieres y luego pulsa Previsualizar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "میزی که می‌خوای رو بنویس، بعد «پیش‌نمایش» رو بزن."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décrivez le bureau que vous voulez, puis cliquez sur Aperçu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Descrivi la scrivania che vuoi, poi fai clic su Anteprima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "理想のデスクを書いてから、「プレビュー」を押します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descreva a mesa que você quer e clique em Pré-visualizar."
          }
        }
      }
    },
    "You can revoke it any time in System Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst das jederzeit in den Systemeinstellungen widerrufen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes revocarlo cuando quieras en Ajustes del Sistema."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هر وقت خواستی، از System Settings پسش بگیر."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez la révoquer à tout moment dans Réglages Système."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi revocarlo in qualsiasi momento in Impostazioni di Sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定でいつでも取り消せます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode revogar a qualquer momento nos Ajustes do Sistema."
          }
        }
      }
    },
