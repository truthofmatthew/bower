    "Apply anyway and Bower places its window when it opens.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trotzdem anwenden – Bower platziert das Fenster, sobald die App geöffnet wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica de todos modos y Bower colocará su ventana cuando se abra."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بازم اعمال کن؛ هر وقت باز شد، Bower پنجره‌ش رو می‌ذاره سر جاش."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appliquez quand même et Bower placera sa fenêtre à son ouverture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Applica comunque e Bower posizionerà la sua finestra quando si apre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このまま適用すると、アプリが開いたときにBowerがウインドウを配置します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplique mesmo assim e o Bower posiciona a janela quando ele abrir."
          }
        }
      }
    },
