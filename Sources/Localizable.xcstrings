    "Off: the middle button goes to apps as usual.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus: Die mittlere Maustaste geht wie gewohnt an die Apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado: el botón central llega a las apps como siempre."
          }
        },
        "fa": {
