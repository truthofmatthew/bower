            "value": "پاک کردن چیدمان %lld"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vider la disposition %lld"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Svuota layout %lld"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レイアウト%lldをクリア"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpar layout %lld"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除布局 %lld"
          }
        }
      }
    },
    "Clear this layout: its name goes back to Untitled and its modes to Native. Its windows stay put.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Layout leeren: Der Name wird wieder „Ohne Titel“, die Modi wieder „Nativ“. Die Fenster bleiben, wo sie sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaciar esta disposición: el nombre vuelve a «Sin título» y los modos a «Nativo». Sus ventanas no se mueven."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این چیدمان رو پاک کن: اسمش برمی‌گرده به «بی‌اسم» و حالت‌هاش به «معمولی». پنجره‌هاش جابه‌جا نمی‌شن."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vider cette disposition : son nom redevient « Sans titre » et ses modes « Natif ». Ses fenêtres ne bougent pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Svuota questo layout: il nome torna «Senza titolo» e le modalità «Nativa». Le sue finestre restano dove sono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このレイアウトをクリアします。名前は「名称未設定」に、モードは「ネイティブ」に戻ります。ウインドウは動きません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpar este layout: o nome volta a “Sem Título” e os modos a “Nativo”. As janelas ficam onde estão."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除此布局：名称恢复为“未命名”，模式恢复为“原生”。其窗口保持不动。"
          }
        }
      }
    },
    "Click a docked window's green button. It floats on the Desktop; click it again to dock it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf die grüne Taste eines angedockten Fensters. Es schwebt dann auf dem Schreibtisch; klicke erneut, um es wieder anzudocken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en el botón verde de una ventana acoplada. Flotará en el Escritorio; vuelve a hacer clic para acoplarla."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "رو دکمه‌ی سبز یه پنجره‌ی داک‌شده کلیک کن. رو دسکتاپ شناور می‌شه؛ دوباره کلیک کن تا داک شه."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur le bouton vert d’une fenêtre dockée. Elle flotte sur le Bureau ; cliquez de nouveau pour la docker."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic sul pulsante verde di una finestra ancorata. Fluttua sulla Scrivania; fai di nuovo clic per ancorarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドッキングしたウインドウの緑のボタンをクリックします。デスクトップ上でフロートし、もう一度クリックするとドッキングします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique no botão verde de uma janela acoplada. Ela flutua na Mesa; clique de novo para acoplá-la."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按已停靠窗口的绿色按钮，它会浮动在桌面上；再次点按即可重新停靠。"
          }
        }
      }
    },
    "Click a slot to hide it, show it, or fill it from the list.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf ein Feld, um es auszublenden, einzublenden oder aus der Liste zu füllen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en un hueco para ocultarlo, mostrarlo o rellenarlo desde la lista."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "رو هر جایگاه کلیک کن تا پنهانش کنی، نشونش بدی یا از فهرست پرش کنی."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur un emplacement pour le masquer, l’afficher ou le remplir depuis la liste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic su una posizione per nasconderla, mostrarla o riempirla dall'elenco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スロットをクリックして、非表示・表示にするか、リストから割り当てます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique em uma posição para ocultá-la, mostrá-la ou preenchê-la a partir da lista."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按槽位可隐藏、显示它，或从列表中填充。"
          }
        }
      }
    },
    "Click a window to go to it  ·  Drag a rectangle to expand it  ·  ⌥-drag to rearrange  ·  Esc to close": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf ein Fenster, um dorthin zu gehen  ·  Zieh ein Rechteck auf, um es auszubreiten  ·  ⌥-Ziehen zum Umordnen  ·  Esc zum Schließen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en una ventana para ir a ella  ·  Arrastra un rectángulo para expandirlo  ·  ⌥-arrastra para reorganizar  ·  Esc para cerrar"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "رو یه پنجره کلیک کن تا بری سراغش  ·  یه مستطیل بکش تا گسترش پیدا کنه  ·  با ⁦⌥⁩-کشیدن جابه‌جا کن  ·  Esc یعنی ببند"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur une fenêtre pour y aller  ·  Tracez un rectangle pour le déployer  ·  ⌥-glisser pour réorganiser  ·  Esc pour fermer"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic su una finestra per andarci  ·  Trascina un rettangolo per espanderlo  ·  ⌥-trascina per riordinare  ·  Esc per chiudere"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウをクリックして移動  ·  矩形をドラッグして展開  ·  ⌥-ドラッグで並べ替え  ·  Escで閉じる"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique em uma janela para ir até ela  ·  Arraste um retângulo para expandi-lo  ·  ⌥-arraste para reorganizar  ·  Esc para fechar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按窗口即可前往  ·  拖出矩形即可展开该区域  ·  按住 ⌥ 拖移可重新排列  ·  按 Esc 关闭"
          }
        }
      }
    },
