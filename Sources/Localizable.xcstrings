    "Opens an arc of layouts. The window moves there and leaves this one.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet einen Bogen mit Layouts. Das Fenster wechselt dorthin und verlässt dieses."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre un arco de disposiciones. La ventana se va a esa y deja esta."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یه کمان از چیدمان‌ها باز می‌کنه. پنجره می‌ره اونجا و از این یکی بیرون می‌ره."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre un arc de dispositions. La fenêtre y part et quitte celle-ci."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre un arco di layout. La finestra si sposta lì e lascia questo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レイアウトの弧を開きます。ウインドウはそちらへ移り、このレイアウトから消えます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre um arco de layouts. A janela vai para lá e sai deste."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开布局弧形菜单。窗口会移到所选布局并离开当前布局。"
          }
        }
      }
    },
    "Opens an arc of thirds: left, centre, right, or two thirds.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet einen Bogen mit Dritteln: links, Mitte, rechts oder zwei Drittel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre un arco de tercios: izquierda, centro, derecha o dos tercios."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یه کمان از یک‌سوم‌ها باز می‌کنه: چپ، وسط، راست یا دو سوم."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre un arc de tiers : gauche, centre, droite ou deux tiers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre un arco di terzi: sinistra, centro, destra o due terzi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3分割の弧を開きます：左、中央、右、または3分の2。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre um arco de terços: esquerda, centro, direita ou dois terços."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开三分之一弧形菜单：左、中、右或三分之二。"
          }
        }
      }
    },
    "Opens an arc of your layouts. Pick one to swap every window on screen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet einen Bogen mit deinen Layouts. Wähl eins, um alle Fenster auf dem Bildschirm zu tauschen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre un arco con tus disposiciones. Elige una para cambiar todas las ventanas de la pantalla."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یه کمان از چیدمان‌هات باز می‌کنه. یکی رو بزن تا همه‌ی پنجره‌های صفحه عوض بشن."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre un arc de vos dispositions. Choisissez-en une pour changer toutes les fenêtres à l’écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre un arco con i tuoi layout. Scegline uno per cambiare tutte le finestre sullo schermo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レイアウトの弧を開きます。選ぶと画面上のウインドウがすべて入れ替わります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre um arco com seus layouts. Escolha um para trocar todas as janelas da tela."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开布局弧形菜单。选择一个即可替换屏幕上的所有窗口。"
          }
        }
      }
    },
    "Opens an arc to pick how this display arranges windows, such as Bento Box.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet einen Bogen, in dem du wählst, wie dieser Bildschirm Fenster anordnet, etwa Bento Box."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre un arco para elegir cómo esta pantalla ordena las ventanas, como Bento Box."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یه کمان باز می‌کنه که انتخاب کنی این صفحه پنجره‌ها رو چطوری بچینه، مثلاً Bento Box."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre un arc pour choisir comment cet écran range les fenêtres, par exemple Bento Box."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre un arco per scegliere come questo schermo dispone le finestre, ad esempio Bento Box."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このディスプレイのウインドウの並べ方（Bento Box など）を選ぶ弧を開きます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre um arco para escolher como esta tela organiza as janelas, como Bento Box."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开弧形菜单，选择此显示器排列窗口的方式，例如 Bento Box。"
          }
        }
      }
    },
    "Opens in": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet in"
          }
