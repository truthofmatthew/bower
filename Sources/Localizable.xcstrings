    "Middle-click anywhere, or press ⌃⌥Space.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke irgendwo mit der mittleren Maustaste oder drücke ⌃⌥Leertaste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic con el botón central en cualquier lugar o pulsa ⌃⌥Espacio."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هر جا با دکمه‌ی وسط موس کلیک کن، یا ⁦⌃⌥Space⁩ رو بزن."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez avec le bouton du milieu n’importe où, ou appuyez sur ⌃⌥Espace."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic con il tasto centrale ovunque o premi ⌃⌥Spazio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どこでも中クリックするか、⌃⌥Spaceを押します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique com o botão do meio em qualquer lugar ou pressione ⌃⌥Espaço."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在任意位置点按中键，或按 ⌃⌥Space。"
          }
        }
      }
    },
