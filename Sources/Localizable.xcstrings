    "Bower is off on this desktop. Turn it on in This Display › Use Bower on This Desktop.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bower ist auf diesem Schreibtisch aus. Einschalten unter Dieses Display › Bower auf diesem Schreibtisch verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bower está desactivado en este escritorio. Actívalo en Esta pantalla › Usar Bower en este escritorio."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "‏Bower روی این دسکتاپ خاموشه. از «این نمایشگر › Bower رو تو این دسکتاپ استفاده کن» روشنش کن."
