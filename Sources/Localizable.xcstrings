    "Press ⇧⌥ and a number: the focused window moves to that layout.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drück ⇧⌥ und eine Zahl: Das aktive Fenster wechselt in dieses Layout."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa ⇧⌥ y un número: la ventana activa pasa a esa disposición."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "‏⁦⇧⌥⁩ و یه عدد بزن: پنجره‌ی فعال می‌ره تو اون چیدمان."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur ⇧⌥ et un chiffre : la fenêtre active passe dans cette disposition."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi ⇧⌥ e un numero: la finestra attiva passa a quel layout."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⇧⌥と数字を押すと、フォーカス中のウインドウがそのレイアウトに移動します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione ⇧⌥ e um número: a janela em foco vai para esse layout."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按 ⇧⌥ 和一个数字：当前窗口会移到该布局。"
          }
        }
      }
    },
    "Press ⌃⌥O, or hold ⌥ and pinch in on the trackpad.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drück ⌃⌥O oder halte ⌥ und zieh auf dem Trackpad zusammen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa ⌃⌥O, o mantén ⌥ y junta los dedos en el trackpad."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "‏⁦⌃⌥O⁩ رو بزن، یا ⁦⌥⁩ رو نگه دار و رو ترک‌پد انگشت‌هات رو جمع کن."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur ⌃⌥O, ou maintenez ⌥ et pincez sur le trackpad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi ⌃⌥O, oppure tieni premuto ⌥ e avvicina le dita sul trackpad."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌃⌥Oを押すか、⌥を押したままトラックパッドでピンチインします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione ⌃⌥O ou segure ⌥ e junte os dedos no trackpad."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按 ⌃⌥O，或按住 ⌥ 在触控板上双指捏合。"
          }
        }
      }
    },
    "Press ⌃⌥Space, tap with three fingers, or click the middle button.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drück ⌃⌥Leertaste, tippe mit drei Fingern oder klicke mit der mittleren Maustaste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa ⌃⌥Espacio, toca con tres dedos o haz clic con el botón central."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "‏⁦⌃⌥Space⁩ رو بزن، با سه انگشت ضربه بزن، یا دکمه‌ی وسط رو کلیک کن."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur ⌃⌥Espace, touchez avec trois doigts ou cliquez avec le bouton du milieu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi ⌃⌥Spazio, tocca con tre dita o fai clic con il tasto centrale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌃⌥Spaceを押すか、3本指でタップするか、中ボタンをクリックします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione ⌃⌥Espaço, toque com três dedos ou clique com o botão do meio."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按 ⌃⌥Space、用三指轻点，或点按中键。"
          }
        }
      }
    },
    "Press ⌃⌥[ to go back to where you were, ⌃⌥] to go forward.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drück ⌃⌥[, um dorthin zurückzugehen, wo du warst, und ⌃⌥], um vorwärtszugehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa ⌃⌥[ para volver a donde estabas y ⌃⌥] para ir adelante."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با ⁦⌃⌥⁩[ برگرد همون‌جایی که بودی، با ⁦⌃⌥⁩] برو جلو."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur ⌃⌥[ pour revenir là où vous étiez, ⌃⌥] pour avancer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi ⌃⌥[ per tornare dov'eri, ⌃⌥] per andare avanti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌃⌥[で元の場所に戻り、⌃⌥]で進みます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione ⌃⌥[ para voltar para onde estava e ⌃⌥] para avançar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按 ⌃⌥[ 返回之前的位置，按 ⌃⌥] 前进。"
          }
        }
      }
    },
    "Press ⌃⌥⇧ and a number to save what you're looking at; ⌃⌥ and the number brings it back.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drück ⌃⌥⇧ und eine Zahl, um zu sichern, was du gerade siehst; ⌃⌥ und die Zahl holen es zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa ⌃⌥⇧ y un número para guardar lo que estás viendo; ⌃⌥ y el número lo trae de vuelta."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "‏⁦⌃⌥⇧⁩ و یه عدد بزن تا چیزی که داری می‌بینی ذخیره شه؛ ⁦⌃⌥⁩ و همون عدد برش می‌گردونه."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur ⌃⌥⇧ et un chiffre pour enregistrer ce que vous voyez ; ⌃⌥ et le chiffre le font revenir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi ⌃⌥⇧ e un numero per salvare ciò che stai guardando; ⌃⌥ e il numero lo riporta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌃⌥⇧と数字を押すと今見ているものを保存し、⌃⌥とその数字で呼び戻します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione ⌃⌥⇧ e um número para salvar o que está vendo; ⌃⌥ e o número trazem de volta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按 ⌃⌥⇧ 和一个数字保存当前所见；按 ⌃⌥ 和该数字即可恢复。"
          }
        }
      }
    },
