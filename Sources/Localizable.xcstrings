    },
    "The front window takes two thirds; the rest stack in the last third.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das vordere Fenster nimmt zwei Drittel, die anderen stapeln sich im letzten Drittel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ventana de delante ocupa dos tercios; el resto se apila en el último tercio."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پنجره‌ی جلویی دو سوم رو می‌گیره و بقیه توی یک‌سوم آخر روی هم چیده می‌شن."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La fenêtre de premier plan prend deux tiers ; les autres s’empilent dans le dernier tiers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La finestra in primo piano prende due terzi; le altre si impilano nell’ultimo terzo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手前のウインドウが3分の2を使い、残りは最後の3分の1に積み重なります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A janela da frente fica com dois terços; as outras se empilham no último terço."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最前面的窗口占三分之二；其余窗口叠放在最后三分之一。"
          }
        }
      }
    },
    "The green button fills the screen instead of opening a new desktop, which no layout can hold.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der grüne Knopf füllt den Bildschirm, statt einen neuen Schreibtisch zu öffnen, den kein Layout halten kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El botón verde llena la pantalla en lugar de abrir un escritorio nuevo, que ninguna disposición puede contener."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دکمه‌ی سبز صفحه رو پر می‌کنه، به‌جای اینکه یه دسکتاپ جدید باز کنه که هیچ چیدمانی نمی‌تونه نگهش داره."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bouton vert remplit l’écran au lieu d’ouvrir un nouveau bureau, qu’aucune disposition ne peut contenir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pulsante verde riempie lo schermo invece di aprire una nuova scrivania, che nessun layout può contenere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "緑のボタンで、レイアウトに収められない新しいデスクトップを開く代わりに画面いっぱいに広げます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O botão verde ocupa a tela em vez de abrir uma mesa nova, que nenhum layout consegue guardar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绿色按钮会填满屏幕，而不是打开新桌面，因为任何布局都无法容纳新桌面。"
          }
        }
      }
    },
