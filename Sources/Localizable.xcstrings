    "Expand part of your arrangement to fill the screen, frame one window, and see every window at once with ⌃⌥O.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Breite einen Teil deiner Anordnung über den Bildschirm aus, stell ein Fenster frei und sieh mit ⌃⌥O alle Fenster auf einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Expande parte de tu distribución hasta llenar la pantalla, encuadra una ventana y ve todas las ventanas a la vez con ⌃⌥O."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یه بخش از چینشت رو گسترش بده تا کل صفحه رو بگیره، یه پنجره رو تکی ببین، و با ⁦⌃⌥O⁩ همه‌ی پنجره‌ها رو یه‌جا ببین."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déployez une partie de votre agencement sur tout l’écran, cadrez une fenêtre seule et voyez toutes les fenêtres d’un coup avec ⌃⌥O."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Espandi una parte della tua disposizione a tutto schermo, inquadra una finestra e vedi tutte le finestre insieme con ⌃⌥O."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "配置の一部を画面いっぱいに展開したり、ウインドウを1つだけ単独表示したり、⌃⌥Oですべてのウインドウを一度に見たりできます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Expanda parte da sua disposição para preencher a tela, enquadre uma janela e veja todas as janelas de uma vez com ⌃⌥O."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将排列的一部分展开到整个屏幕，单独显示一个窗口，并用 ⌃⌥O 一次查看所有窗口。"
          }
        }
      }
    },
