    "New windows of a routed app open in that layout, even while another is showing. Unrouted apps stay where you put them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Fenster einer zugeordneten App öffnen sich in deren Layout, auch wenn gerade ein anderes angezeigt wird. Nicht zugeordnete Apps bleiben, wo du sie platziert hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las ventanas nuevas de una app enrutada se abren en esa disposición, aunque se esté mostrando otra. Las apps sin enrutar se quedan donde las pongas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هر برنامه‌ای که براش چیدمان تعیین کردی، پنجره‌های تازه‌ش تو همون چیدمان باز می‌شن، حتی وقتی یه چیدمان دیگه رو صفحه‌ست. بقیه‌ی برنامه‌ها همون‌جایی می‌مونن که گذاشتیشون."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouvelles fenêtres d’une app routée s’ouvrent dans sa disposition, même quand une autre est affichée. Les apps non routées restent là où vous les avez mises."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nuove finestre di un'app instradata si aprono in quel layout, anche quando ne è visibile un altro. Le app non instradate restano dove le hai messe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "振り分けたアプリの新しいウインドウは、別のレイアウトを表示中でもそのレイアウトで開きます。振り分けていないアプリは置いた場所に留まります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Novas janelas de um app direcionado abrem nesse layout, mesmo enquanto outro está visível. Apps não direcionados ficam onde você os colocou."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已分配应用的新窗口会在对应布局中打开，即使当前显示的是另一个布局。未分配的应用保持在你放置的位置。"
          }
        }
      }
    },
