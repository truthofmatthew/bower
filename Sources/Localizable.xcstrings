        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他"
          }
        }
      }
    },
    "Otherwise a gap's handle shows when the pointer is over it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonst erscheint der Griff einer Lücke, wenn der Zeiger darüber ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no, el tirador de una separación aparece cuando el puntero está encima."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "وگرنه دستگیره‌ی هر فاصله وقتی نشانگر روشه پیدا می‌شه."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinon, la poignée d’un espace apparaît quand le pointeur le survole."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Altrimenti la maniglia di uno spazio appare quando il puntatore ci passa sopra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフのときは、ポインタが隙間の上にあるときにハンドルを表示します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Caso contrário, a alça de um espaço aparece quando o cursor está sobre ele."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "否则，指针悬停在间隙上时才显示其手柄。"
          }
        }
      }
    },
    "Otherwise dragging back undoes each push.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonst macht Zurückziehen jedes Wegschieben rückgängig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no, arrastrar hacia atrás deshace cada empujón."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "وگرنه کشیدن به عقب، هل دادن‌ها رو یکی‌یکی برمی‌گردونه."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinon, revenir en arrière annule chaque poussée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Altrimenti trascinare indietro annulla ogni spinta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフのときは、ドラッグして戻すと押しのけた分が1つずつ元に戻ります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Caso contrário, arrastar de volta desfaz cada empurrão."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "否则，往回拖动会逐一撤销每次推移。"
          }
        }
      }
    },
    "Otherwise they're covered until you let go, and resized once.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonst werden sie bis zum Loslassen verdeckt und dann einmal angepasst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no, quedan tapadas hasta que sueltas y se redimensionan una vez."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "وگرنه تا ول نکنی زیرش می‌مونن و فقط یه بار اندازه‌شون عوض می‌شه."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinon, elles sont masquées jusqu’au relâchement, puis redimensionnées une fois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Altrimenti restano coperte finché non rilasci, e vengono ridimensionate una volta sola."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフのときは、離すまで覆われたままで、サイズ変更は1回だけです。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Caso contrário, ficam cobertas até você soltar, e são redimensionadas uma vez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "否则，它们会被遮住，直到你松开，然后一次性调整大小。"
          }
        }
      }
    },
