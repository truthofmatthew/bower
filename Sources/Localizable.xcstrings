    "On a Bento Box display, the tile of an app you quit can wait for it to come back.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf einem Bento Box-Display kann die Kachel einer beendeten App auf deren Rückkehr warten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En una pantalla Bento Box, el mosaico de una app que cierras puede esperar a que vuelva."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "رو نمایشگر Bento Box، اگه از یه برنامه بیرون بیای، کاشیش می‌تونه منتظر بمونه تا برگرده."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur un écran Bento Box, la tuile d’une app que vous quittez peut attendre son retour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su uno schermo Bento Box, il riquadro di un'app chiusa può attenderne il ritorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bento Boxのディスプレイでは、終了したアプリのタイルを再起動まで残しておけます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em uma tela Bento Box, o bloco de um app que você encerrou pode esperar ele voltar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Bento Box 显示器上，你退出的应用所在的平铺位置可以等它回来。"
          }
        }
      }
    },
    "On the right": {
