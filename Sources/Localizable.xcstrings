    "Recipes are sent only to this endpoint. With Ollama or LM Studio nothing leaves your Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezepte werden nur an diesen Endpunkt gesendet. Mit Ollama oder LM Studio verlässt nichts deinen Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las recetas solo se envían a este endpoint. Con Ollama o LM Studio nada sale de tu Mac."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دستورها فقط به همین سرور فرستاده می‌شن. با Ollama یا LM Studio هیچی از این Mac بیرون نمی‌ره."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les recettes sont envoyées uniquement à ce point de terminaison. Avec Ollama ou LM Studio, rien ne quitte votre Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le ricette vengono inviate solo a questo endpoint. Con Ollama o LM Studio nulla lascia il tuo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レシピはこのエンドポイントにのみ送信されます。OllamaやLM Studioなら、データがMacの外に出ることはありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As receitas são enviadas apenas para este endpoint. Com Ollama ou LM Studio, nada sai do seu Mac."
          }
        }
      }
    },
