    "Back to how they came. Layouts, shortcuts and workspaces stay.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zurück zum Auslieferungszustand. Layouts, Kurzbefehle und Arbeitsbereiche bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se restablecen los valores de fábrica. Las disposiciones, los atajos y los espacios de trabajo se conservan."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همه‌چی برمی‌گرده به حالت اول. چیدمان‌ها، میان‌برها و فضاهای کار سر جاشون می‌مونن."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retour aux réglages d’origine. Les dispositions, raccourcis et espaces de travail sont conservés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si torna alle impostazioni originali. Layout, abbreviazioni e spazi di lavoro restano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初期状態に戻します。レイアウト、ショートカット、ワークスペースはそのまま残ります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo volta ao padrão. Layouts, atalhos e espaços de trabalho são mantidos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复为初始状态。布局、快捷键和工作区会保留。"
          }
        }
      }
    },
