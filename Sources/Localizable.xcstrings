            "value": "打开位置"
          }
        }
      }
    },
    "Optional: see your windows as they are": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional: Sieh deine Fenster so, wie sie sind"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional: ve tus ventanas tal como son"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اختیاری: پنجره‌هات رو همون‌طور که هستن ببین"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif : voir vos fenêtres telles qu’elles sont"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Facoltativo: vedi le finestre come sono"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オプション：ウインドウの実際の様子を見る"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional: veja suas janelas como elas são"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选：查看窗口的实际样子"
          }
        }
      }
    },
    "Other": {
      "localizations": {
