    "Save a view with ⌃⌥⇧1–9, come back with ⌃⌥1–9, and go back and forward like a browser.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichere eine Ansicht mit ⌃⌥⇧1–9, kehre mit ⌃⌥1–9 zurück und geh vor und zurück wie in einem Browser."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda una vista con ⌃⌥⇧1–9, vuelve con ⌃⌥1–9 y ve atrás y adelante como en un navegador."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با ⁦⌃⌥⇧1–9⁩ یه نما ذخیره کن، با ⁦⌃⌥1–9⁩ برگرد بهش، و مثل مرورگر عقب و جلو برو."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez une vue avec ⌃⌥⇧1–9, revenez-y avec ⌃⌥1–9, et naviguez en avant et en arrière comme dans un navigateur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva una vista con ⌃⌥⇧1–9, tornaci con ⌃⌥1–9 e vai avanti e indietro come in un browser."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌃⌥⇧1–9でビューを保存し、⌃⌥1–9で呼び戻し、ブラウザのように戻る/進むができます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve uma vista com ⌃⌥⇧1–9, volte com ⌃⌥1–9, e volte e avance como num navegador."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 ⌃⌥⇧1–9 保存视图，用 ⌃⌥1–9 返回，还能像浏览器一样后退和前进。"
          }
        }
      }
    },
