    "Greyed actions are already on the wheel. The inner ring always holds the eight snap targets. Drop onto the centre to cancel a drag.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgegraute Aktionen sind bereits auf dem Snap-Rad. Der innere Ring enthält immer die acht Einrastziele. Zum Abbrechen in der Mitte ablegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las acciones atenuadas ya están en la rueda. El anillo interior siempre contiene las ocho posiciones de ajuste. Suelta en el centro para cancelar un arrastre."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کارهای خاکستری از قبل روی چرخن. حلقه‌ی داخلی همیشه هشت تا جای چینش رو داره. اگه پشیمون شدی، وسط ول کن."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les actions grisées sont déjà sur la roue. L’anneau intérieur contient toujours les huit cibles d’ancrage. Déposez au centre pour annuler un glissement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le azioni in grigio sono già sulla ruota. L'anello interno contiene sempre le otto destinazioni di aggancio. Rilascia al centro per annullare il trascinamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グレーのアクションはすでにホイール上にあります。内側のリングには常に8つのスナップ先があります。中央にドロップするとドラッグをキャンセルします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ações em cinza já estão na roda. O anel interno sempre contém os oito destinos de encaixe. Solte no centro para cancelar o arraste."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "灰色的操作已在轮盘上。内圈始终是八个吸附目标。拖到中心可取消拖动。"
          }
        }
      }
    },
    "Grouped. Click a tab to switch.": {
      "localizations": {
        "de": {
