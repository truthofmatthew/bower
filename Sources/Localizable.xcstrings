    "Double-click a title bar frames the window on its own": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doppelklick auf eine Titelleiste stellt das Fenster frei"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Doble clic en una barra de título encuadra la ventana sola"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دوبار کلیک روی نوار عنوان، پنجره رو تکی نشون می‌ده"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-cliquer sur une barre de titre cadre la fenêtre seule"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il doppio clic sulla barra del titolo inquadra la finestra da sola"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトルバーのダブルクリックでウインドウを単独表示"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clicar duas vezes na barra de título enquadra a janela sozinha"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连按标题栏可单独显示窗口"
          }
        }
      }
    },
    "Double-click a window's title bar. Double-click it again to go back.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doppelklicke auf die Titelleiste eines Fensters. Doppelklicke erneut, um zurückzugehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz doble clic en la barra de título de una ventana. Vuelve a hacer doble clic para volver."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "رو نوار عنوان یه پنجره دوبار کلیک کن. دوباره دوبار کلیک کن تا برگردی."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-cliquez sur la barre de titre d’une fenêtre. Double-cliquez de nouveau pour revenir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai doppio clic sulla barra del titolo di una finestra. Fai di nuovo doppio clic per tornare indietro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウのタイトルバーをダブルクリックします。もう一度ダブルクリックすると戻ります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique duas vezes na barra de título de uma janela. Clique duas vezes de novo para voltar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连按窗口的标题栏。再次连按即可返回。"
          }
        }
      }
    },
    "Double-click again to go back. ⌥-double-click still zooms.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doppelklicke erneut, um zurückzugehen. ⌥-Doppelklick zoomt weiterhin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz doble clic otra vez para volver. ⌥-doble clic sigue haciendo zoom."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دوباره دوبار کلیک کن تا برگردی. ⁦⌥⁩-دوبار کلیک هنوزم زوم می‌کنه."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-cliquez de nouveau pour revenir. ⌥-double-clic zoome toujours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai di nuovo doppio clic per tornare indietro. ⌥-doppio clic esegue ancora lo zoom."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度ダブルクリックで戻ります。⌥-ダブルクリックでは従来どおりズームします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique duas vezes de novo para voltar. ⌥-clique duplo ainda aplica zoom."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再次连按即可返回。按住 ⌥ 连按仍可缩放。"
          }
        }
      }
    },
    "Double-click the icon to see the window on its own. It's a real window again as soon as it fits.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doppelklicke auf das Symbol, um das Fenster einzeln zu sehen. Sobald es passt, ist es wieder ein echtes Fenster."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz doble clic en el icono para ver la ventana sola. Vuelve a ser una ventana real en cuanto cabe."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "رو آیکون دوبار کلیک کن تا پنجره رو تکی ببینی. همین که جا بشه، دوباره یه پنجره‌ی واقعیه."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-cliquez sur l’icône pour voir la fenêtre seule. Elle redevient une vraie fenêtre dès qu’elle tient."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai doppio clic sull'icona per vedere la finestra da sola. Torna una finestra vera appena ci sta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイコンをダブルクリックするとウインドウを単独表示します。収まるサイズになれば、すぐに通常のウインドウに戻ります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique duas vezes no ícone para ver a janela sozinha. Ela volta a ser uma janela real assim que couber."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连按图标可单独查看该窗口。一旦放得下，它就会恢复为真实窗口。"
          }
        }
      }
    },
    "Drag a window onto the middle of another and pause a moment. Let go, and they share a strip of tabs.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieh ein Fenster auf die Mitte eines anderen und warte einen Moment. Lass los, und beide teilen sich eine Tab-Leiste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra una ventana al centro de otra y espera un momento. Al soltarla, comparten una tira de pestañas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یه پنجره رو بکش وسط یکی دیگه و یه لحظه نگه دار. ولش کن، یه نوار زبانه‌ی مشترک پیدا می‌کنن."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser une fenêtre au milieu d’une autre et attendez un instant. Relâchez, et elles partagent une barre d’onglets."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina una finestra al centro di un'altra e attendi un attimo. Rilasciala e condivideranno una striscia di pannelli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウを別のウインドウの中央にドラッグして少し待ちます。離すと、1つのタブストリップを共有します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste uma janela até o meio de outra e espere um instante. Solte, e elas compartilham uma faixa de abas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将窗口拖到另一个窗口的中间并稍作停留。松开后，它们会共用一排标签页。"
          }
        }
      }
    },
