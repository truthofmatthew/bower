    "Try again, or pick a larger model in Settings › AI. Your recipe hasn't changed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuche es erneut oder wähle ein größeres Modell in Einstellungen › KI. Dein Rezept wurde nicht geändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a intentarlo o elige un modelo más grande en Ajustes › IA. Tu receta no ha cambiado."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دوباره امتحان کن، یا تو تنظیمات › هوش مصنوعی یه مدل بزرگ‌تر انتخاب کن. دستورت دست نخورده."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réessayez ou choisissez un modèle plus grand dans Réglages › IA. Votre recette n’a pas changé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riprova o scegli un modello più grande in Impostazioni › IA. La ricetta non è stata modificata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再試行するか、設定 › AIでより大きなモデルを選択してください。レシピは変更されていません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tente novamente ou escolha um modelo maior em Ajustes › IA. Sua receita não foi alterada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重试，或在设置 › AI 中选择更大的模型。你的配方未更改。"
          }
        }
      }
    },
