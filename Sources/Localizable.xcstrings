    "Windows an app reopens go back to their places": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenster, die eine App wieder öffnet, kommen an ihren Platz zurück"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las ventanas que reabre una app vuelven a su sitio"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پنجره‌هایی که یه برنامه دوباره باز می‌کنه، برگردن سر جاشون"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fenêtres qu’une app rouvre reprennent leur place"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le finestre che un'app riapre tornano al loro posto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリが再び開いたウインドウを元の場所に戻す"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Janelas que um app reabre voltam ao seu lugar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用重新打开的窗口回到原位"
          }
        }
      }
    },
    "Windows can be squeezed below their app's minimum": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenster können kleiner als das Minimum ihrer App werden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las ventanas pueden encogerse por debajo del mínimo de su app"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پنجره‌ها می‌تونن از حداقل اندازه‌ی برنامه‌شون کوچیک‌تر شن"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fenêtres peuvent être réduites sous le minimum de leur app"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le finestre possono essere ridotte sotto il minimo della loro app"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリの最小サイズより小さくできる"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As janelas podem ficar menores que o mínimo do app"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口可以被压缩到其应用的最小尺寸以下"
          }
        }
      }
    },
    "Windows make room live during drags": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenster machen beim Ziehen sofort Platz"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las ventanas hacen sitio en directo al arrastrar"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پنجره‌ها موقع کشیدن، همون لحظه جا باز کنن"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fenêtres font de la place en direct pendant le glissement"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le finestre fanno spazio in tempo reale durante il trascinamento"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグ中にリアルタイムで場所を空ける"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As janelas abrem espaço ao vivo durante o arraste"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动时窗口实时让出空间"
          }
        }
      }
    },
    "Windows never overlap. Drag one to the edge of another to dock it there.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenster überlappen sich nie. Zieh eines an den Rand eines anderen, um es dort anzudocken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las ventanas nunca se superponen. Arrastra una al borde de otra para acoplarla ahí."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پنجره‌ها هیچ‌وقت روی هم نمی‌افتن. یکی رو بکش لبه‌ی یکی دیگه تا همون‌جا داک شه."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fenêtres ne se chevauchent jamais. Faites-en glisser une jusqu’au bord d’une autre pour la docker à cet endroit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le finestre non si sovrappongono mai. Trascinane una sul bordo di un'altra per ancorarla lì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウは重なりません。別のウインドウの端にドラッグすると、そこにドッキングします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As janelas nunca se sobrepõem. Arraste uma até a borda de outra para acoplá-la ali."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口永不重叠。将窗口拖到另一个窗口的边缘即可停靠在那里。"
          }
        }
      }
    },
    "Windows of these apps are left alone": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenster dieser Apps bleiben unberührt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las ventanas de estas apps se dejan como están"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با پنجره‌های این برنامه‌ها کاری نداریم"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fenêtres de ces apps sont ignorées"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le finestre di queste app vengono lasciate stare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのアプリのウインドウは対象外"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Janelas destes apps são ignoradas"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些应用的窗口不受管理"
          }
        }
      }
    },
    "Windows out of view, and a group's other tabs. Leaves room for the rest in Mission Control; each is resized as it's shown again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenster außer Sicht und die anderen Tabs einer Gruppe. Lässt in Mission Control Platz für den Rest; jedes wird beim erneuten Anzeigen wieder angepasst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ventanas fuera de la vista y las otras pestañas de un grupo. Deja sitio para el resto en Mission Control; cada una se redimensiona al volver a mostrarse."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پنجره‌هایی که از دید بیرونن، و بقیه‌ی زبانه‌های یه گروه. تو Mission Control برای بقیه جا می‌ذاره؛ هر کدوم وقتی دوباره نشون داده شه، اندازه‌ش برمی‌گرده."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fenêtres hors de vue et les autres onglets d’un groupe. Laisse de la place au reste dans Mission Control ; chacune est redimensionnée quand elle réapparaît."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Finestre fuori vista e gli altri pannelli di un gruppo. Lascia spazio al resto in Mission Control; ognuna viene ridimensionata quando torna visibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面外のウインドウと、グループのほかのタブ。Mission Controlで残りのウインドウに場所を残します。再び表示されるときにサイズが戻ります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Janelas fora de vista e as outras abas de um grupo. Deixa espaço para o resto no Mission Control; cada uma é redimensionada ao ser mostrada de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不在视图中的窗口，以及组内的其他标签页。为调度中心中的其余窗口留出空间；每个窗口再次显示时会调整大小。"
          }
        }
      }
    },
    "Windows share one pane, with a tab for each.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenster teilen sich einen Bereich, mit einem Tab pro Fenster."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las ventanas comparten un panel, con una pestaña para cada una."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پنجره‌ها توی یه قاب با هم‌ان و هر کدوم یه زبانه دارن."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fenêtres partagent un panneau, avec un onglet chacune."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le finestre condividono un pannello, con una scheda per ciascuna."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウが1つの枠を共有し、それぞれにタブが付きます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As janelas dividem um painel, com uma aba para cada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口共用一个窗格，每个窗口一个标签页。"
          }
        }
      }
    },
    "Windows stay where you put them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenster bleiben, wo du sie hinlegst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las ventanas se quedan donde las pones."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پنجره‌ها همون جایی می‌مونن که خودت گذاشتی."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fenêtres restent là où vous les mettez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le finestre restano dove le metti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウは置いた場所にとどまります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As janelas ficam onde você as coloca."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口保持在你放置的位置。"
          }
        }
      }
    },
    "Windows that haven't come back since they closed, their app quit or the Mac restarted: their places, and what Bower knows them by.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenster, die nicht zurückgekommen sind, seit sie geschlossen wurden, ihre App beendet oder der Mac neu gestartet wurde: ihre Plätze und woran Bower sie erkennt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ventanas que no han vuelto desde que se cerraron, se salió de su app o se reinició el Mac: sus posiciones y cómo las reconoce Bower."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پنجره‌هایی که از وقتی بسته شدن، برنامه‌شون بسته شد یا Mac ری‌استارت شد، برنگشتن: جاشون، و اینکه Bower با چی می‌شناسه‌شون."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fenêtres qui ne sont pas revenues depuis leur fermeture, celle de leur app ou le redémarrage du Mac : leur place, et ce qui permet à Bower de les reconnaître."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Finestre che non sono tornate da quando sono state chiuse, la loro app è stata chiusa o il Mac è stato riavviato: le loro posizioni e come le riconosce Bower."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じたり、アプリが終了したり、Macが再起動したりしてから戻ってきていないウインドウ。その場所と、Bowerが識別に使う情報です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Janelas que não voltaram desde que foram fechadas, o app foi encerrado ou o Mac foi reiniciado: suas posições e como o Bower as reconhece."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自关闭、应用退出或 Mac 重启后尚未回来的窗口：它们的位置，以及 Bower 识别它们的信息。"
          }
        }
      }
    },
    "Windows tile on their own. The one you used last gets the big column.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenster ordnen sich selbst an. Das zuletzt benutzte bekommt die große Spalte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las ventanas se colocan solas. La última que usaste ocupa la columna grande."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پنجره‌ها خودشون چیده می‌شن. اونی که آخر باهاش کار کردی ستون بزرگ رو می‌گیره."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fenêtres se rangent toutes seules. La dernière utilisée prend la grande colonne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le finestre si dispongono da sole. L’ultima usata prende la colonna grande."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウが自動で並びます。最後に使ったものが大きな列に入ります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As janelas se organizam sozinhas. A última usada fica com a coluna grande."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口自动平铺。你最后使用的窗口占据大栏。"
          }
        }
      }
    },
    "With Screen Recording allowed, the overview and moving windows show real contents: still pictures, never recorded or kept. Without it, windows show as their app's colour and icon.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit erlaubter Bildschirmaufnahme zeigen die Übersicht und bewegte Fenster echte Inhalte: Standbilder, nie aufgezeichnet oder gespeichert. Ohne sie erscheinen Fenster in der Farbe und mit dem Symbol ihrer App."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con Grabación de pantalla permitida, la vista general y las ventanas en movimiento muestran el contenido real: imágenes fijas, nunca grabadas ni guardadas. Sin ella, las ventanas se muestran con el color y el icono de su app."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اگه اجازه‌ی Screen Recording رو بدی، نمای کلی و پنجره‌های در حال حرکت محتوای واقعی رو نشون می‌دن: فقط عکس ثابت، هیچ‌وقت ضبط یا نگه‌داری نمی‌شه. بدونش، پنجره‌ها با رنگ و آیکون برنامه‌شون نشون داده می‌شن."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si l’enregistrement de l’écran est autorisé, la vue d’ensemble et les fenêtres en mouvement montrent leur vrai contenu : des images fixes, jamais enregistrées ni conservées. Sinon, les fenêtres s’affichent avec la couleur et l’icône de leur app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con Registrazione schermo consentita, la panoramica e le finestre in movimento mostrano il contenuto reale: immagini fisse, mai registrate né conservate. Senza, le finestre appaiono con il colore e l'icona della loro app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面収録を許可すると、オーバービューと移動中のウインドウに実際の内容を表示します。静止画のみで、録画や保存はしません。許可しない場合は、アプリのカラーとアイコンで表示します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com a Gravação de Tela permitida, a visão geral e as janelas em movimento mostram o conteúdo real: imagens estáticas, nunca gravadas nem guardadas. Sem ela, as janelas aparecem com a cor e o ícone do app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许“录屏与系统录音”后，总览和移动中的窗口会显示真实内容：仅为静态图像，绝不录制或保存。未允许时，窗口显示为其应用的颜色和图标。"
          }
        }
      }
    },
    "With Screen Recording allowed, the overview and moving windows show their real contents: still pictures, never recorded or kept. Without it, windows show as their app's colour and icon.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit erlaubter Bildschirmaufnahme zeigen die Übersicht und bewegte Fenster ihre echten Inhalte: Standbilder, nie aufgezeichnet oder gespeichert. Ohne sie erscheinen Fenster in der Farbe und mit dem Symbol ihrer App."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con Grabación de pantalla permitida, la vista general y las ventanas en movimiento muestran su contenido real: imágenes fijas, nunca grabadas ni guardadas. Sin ella, las ventanas se muestran con el color y el icono de su app."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اگه اجازه‌ی Screen Recording رو بدی، نمای کلی و پنجره‌های در حال حرکت محتوای واقعی‌شون رو نشون می‌دن: فقط عکس ثابت، هیچ‌وقت ضبط یا نگه‌داری نمی‌شه. بدونش، پنجره‌ها با رنگ و آیکون برنامه‌شون نشون داده می‌شن."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si l’enregistrement de l’écran est autorisé, la vue d’ensemble et les fenêtres en mouvement montrent leur vrai contenu : des images fixes, jamais enregistrées ni conservées. Sinon, les fenêtres s’affichent avec la couleur et l’icône de leur app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con Registrazione schermo consentita, la panoramica e le finestre in movimento mostrano il loro contenuto reale: immagini fisse, mai registrate né conservate. Senza, le finestre appaiono con il colore e l'icona della loro app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面収録を許可すると、オーバービューと移動中のウインドウに実際の内容を表示します。静止画のみで、録画や保存はしません。許可しない場合は、アプリのカラーとアイコンで表示します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com a Gravação de Tela permitida, a visão geral e as janelas em movimento mostram seu conteúdo real: imagens estáticas, nunca gravadas nem guardadas. Sem ela, as janelas aparecem com a cor e o ícone do app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许“录屏与系统录音”后，总览和移动中的窗口会显示其真实内容：仅为静态图像，绝不录制或保存。未允许时，窗口显示为其应用的颜色和图标。"
          }
        }
      }
    },
    "With an Edge or Chrome window in front, Bower's menu › the app › New windows open in routes just that profile.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ist ein Edge- oder Chrome-Fenster vorne, leitet Bower-Menü › die App › Neue Fenster öffnen in nur dieses Profil weiter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con una ventana de Edge o Chrome delante, menú de Bower › la app › Las ventanas nuevas se abren en asigna solo ese perfil."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "وقتی یه پنجره‌ی Edge یا Chrome جلوئه، منوی Bower › اون برنامه › «پنجره‌های جدید باز می‌شن تو» فقط همون پروفایل رو می‌فرسته."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec une fenêtre Edge ou Chrome au premier plan, menu de Bower › l’app › Les nouvelles fenêtres s’ouvrent dans n’oriente que ce profil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con una finestra di Edge o Chrome in primo piano, menu di Bower › l’app › Le nuove finestre si aprono in indirizza solo quel profilo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "EdgeやChromeのウインドウが前面にあるとき、Bowerのメニュー › アプリ › 新しいウインドウの表示先 で、そのプロファイルだけを振り分けられます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com uma janela do Edge ou Chrome na frente, menu do Bower › o app › Novas janelas abrem em direciona só esse perfil."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当 Edge 或 Chrome 窗口在最前面时，Bower 菜单 › 该 App › 新窗口打开于 只会安排这个配置文件。"
          }
        }
      }
    },
    "With ⌥ anywhere, or on bare desktop": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit ⌥ überall oder auf freiem Schreibtisch"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con ⌥ en cualquier lugar, o sobre el escritorio vacío"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با ⁦⌥⁩ هر جا، یا رو جای خالی دسکتاپ"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec ⌥ partout, ou sur le bureau vide"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con ⌥ ovunque, o sulla scrivania vuota"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どこでも⌥を押しながら、またはデスクトップの空いている場所で"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com ⌥ em qualquer lugar, ou na mesa vazia"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任意位置按住 ⌥，或在空白桌面上"
          }
        }
      }
    },
    "Within the focused tab group": {
