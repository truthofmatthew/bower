    "Dock mode": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock-Modus"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modo Dock"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حالت داک"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mode Dock"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modalità Dock"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドックモード"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Modo Dock"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停靠模式"
          }
        }
      }
    },
    "Dock mode is a Window Mode, set per display in each layout (Bower's menu › Mode for This Display). Windows never overlap: drag one by its title bar to the edge of another, or of the screen, to dock it there.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Dock-Modus ist ein Fenstermodus, den du pro Display in jedem Layout festlegst (Bower-Menü › Modus für dieses Display). Fenster überlappen sich nie: Zieh eines an seiner Titelleiste an den Rand eines anderen oder des Bildschirms, um es dort anzudocken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo Dock es un modo de ventana que se ajusta por pantalla en cada disposición (menú de Bower › Modo para esta pantalla). Las ventanas nunca se superponen: arrastra una por su barra de título hasta el borde de otra, o de la pantalla, para acoplarla ahí."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حالت داک یکی از حالت‌های پنجره‌ست و تو هر چیدمان، برای هر نمایشگر جدا تنظیم می‌شه (منوی Bower › حالت این نمایشگر). پنجره‌ها هیچ‌وقت روی هم نمی‌افتن: یکی رو از نوار عنوانش بکش لبه‌ی یکی دیگه، یا لبه‌ی صفحه، تا همون‌جا داک شه."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode Dock est un mode de fenêtre, réglé par écran dans chaque disposition (menu de Bower › Mode pour cet écran). Les fenêtres ne se chevauchent jamais : faites-en glisser une par sa barre de titre jusqu’au bord d’une autre, ou de l’écran, pour la docker à cet endroit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La modalità Dock è una modalità finestra, impostata per schermo in ogni layout (menu di Bower › Modalità per questo schermo). Le finestre non si sovrappongono mai: trascinane una per la barra del titolo sul bordo di un'altra, o dello schermo, per ancorarla lì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドックモードはウインドウモードの1つで、各レイアウトでディスプレイごとに設定します（Bowerのメニュー › このディスプレイのモード）。ウインドウは重なりません。タイトルバーを持って別のウインドウや画面の端にドラッグすると、そこにドッキングします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modo Dock é um Modo de Janela, definido por tela em cada layout (menu do Bower › Modo para Esta Tela). As janelas nunca se sobrepõem: arraste uma pela barra de título até a borda de outra, ou da tela, para acoplá-la ali."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停靠模式是一种窗口模式，在每个布局中按显示器设置（Bower 菜单 › 此显示器的模式）。窗口永不重叠：按住标题栏将窗口拖到另一个窗口或屏幕的边缘，即可停靠在那里。"
          }
        }
      }
    },
    "Dock, gestures, appearance and updates. Layouts, shortcuts and workspaces stay.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock, Gesten, Erscheinungsbild und Updates. Layouts, Kurzbefehle und Arbeitsbereiche bleiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock, gestos, apariencia y actualizaciones. Las disposiciones, los atajos y los espacios de trabajo se mantienen."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "داک، ژست‌ها، ظاهر و به‌روزرسانی. چیدمان‌ها، میان‌برها و فضاهای کار دست نمی‌خورن."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock, gestes, apparence et mises à jour. Les dispositions, raccourcis et espaces de travail restent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock, gesti, aspetto e aggiornamenti. Layout, abbreviazioni e spazi di lavoro restano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドック、ジェスチャ、外観、アップデート。レイアウト、ショートカット、ワークスペースはそのままです。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock, gestos, aparência e atualizações. Layouts, atalhos e espaços de trabalho são mantidos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停靠、手势、外观和更新。布局、快捷键和工作区保持不变。"
          }
        }
      }
    },
    "Docked. Its neighbours made room.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angedockt. Die Nachbarn haben Platz gemacht."
          }
        },
