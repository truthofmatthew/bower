    },
    "Your four front windows take a corner each.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine vier vorderen Fenster bekommen je eine Ecke."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus cuatro ventanas de delante ocupan una esquina cada una."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "چهار تا پنجره‌ی جلویی هر کدوم یه گوشه رو می‌گیرن."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos quatre fenêtres de premier plan prennent chacune un coin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le quattro finestre in primo piano prendono un angolo ciascuna."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手前の4つのウインドウがそれぞれ四隅に収まります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas quatro janelas da frente ficam cada uma em um canto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最前面的四个窗口各占一角。"
          }
        }
      }
    },
    "Your layouts, shortcuts and workspaces stay.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Layouts, Kurzbefehle und Arbeitsbereiche bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus disposiciones, atajos y espacios de trabajo se conservan."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "چیدمان‌ها، میان‌برها و فضاهای کارت سر جاشون می‌مونن."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos dispositions, raccourcis et espaces de travail sont conservés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Layout, abbreviazioni e spazi di lavoro restano invariati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レイアウト、ショートカット、ワークスペースはそのまま残ります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus layouts, atalhos e espaços de trabalho são mantidos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的布局、快捷键和工作区会保留。"
          }
        }
      }
    },
