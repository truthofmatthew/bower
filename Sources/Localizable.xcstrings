    "It keeps its windows when you switch layouts on other displays. Click to unpin.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es behält seine Fenster, wenn du auf anderen Displays das Layout wechselst. Zum Lösen klicken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva sus ventanas cuando cambias de disposición en otras pantallas. Haz clic para dejar de fijarla."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "وقتی رو نمایشگرهای دیگه چیدمان رو عوض می‌کنی، پنجره‌هاش سر جاشون می‌مونن. کلیک کن تا سنجاقش رو برداری."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il garde ses fenêtres quand vous changez de disposition sur d’autres écrans. Cliquez pour le désépingler."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene le sue finestre quando cambi layout sugli altri schermi. Fai clic per sbloccarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのディスプレイでレイアウトを切り替えても、ウインドウはそのまま残ります。クリックで固定解除します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ela mantém suas janelas quando você troca de layout em outras telas. Clique para desafixar."
          }
        }
      }
    },
