    "Release on this slot to run %@. Drag another action here to replace it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Feld loslassen, um %@ auszuführen. Ziehe eine andere Aktion hierher, um sie zu ersetzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suelta en este hueco para ejecutar %@. Arrastra otra acción aquí para sustituirla."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "رو این جایگاه ول کن تا ⁨%@⁩ اجرا شه. یه کار دیگه رو بکش اینجا تا جاش بشینه."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relâchez sur cet emplacement pour exécuter %@. Faites glisser une autre action ici pour la remplacer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rilascia su questa posizione per eseguire %@. Trascina qui un'altra azione per sostituirla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスロットで離すと%@を実行します。別のアクションをここにドラッグすると置き換えます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Solte nesta posição para executar %@. Arraste outra ação para cá para substituí-la."
          }
        }
      }
    },
