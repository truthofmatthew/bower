    "Turn it on in Settings › Gestures, then swipe sideways with three fingers.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte es in Einstellungen › Gesten ein und streiche dann mit drei Fingern seitwärts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actívalo en Ajustes › Gestos y luego desliza de lado con tres dedos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تو تنظیمات › ژست‌ها روشنش کن، بعد با سه انگشت به پهلو سوایپ کن."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez-le dans Réglages › Gestes, puis balayez latéralement avec trois doigts."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attivalo in Impostazioni › Gesti, poi scorri lateralmente con tre dita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定 › ジェスチャでオンにしてから、3本指で横にスワイプします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative em Ajustes › Gestos e deslize para o lado com três dedos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在设置 › 手势中开启，然后用三指左右轻扫。"
          }
        }
      }
    },
    "Turn it on in Settings › Shortcuts, then swipe sideways with three fingers.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte es in Einstellungen › Kurzbefehle ein und streiche dann mit drei Fingern seitwärts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actívalo en Ajustes › Atajos y luego desliza de lado con tres dedos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تو تنظیمات › میان‌برها روشنش کن، بعد با سه انگشت به پهلو سوایپ کن."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez-le dans Réglages › Raccourcis, puis balayez latéralement avec trois doigts."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attivalo in Impostazioni › Abbreviazioni, poi scorri lateralmente con tre dita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定 › ショートカットでオンにしてから、3本指で横にスワイプします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative em Ajustes › Atalhos e deslize para o lado com três dedos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在设置 › 快捷键中开启，然后用三指左右轻扫。"
          }
        }
      }
    },
    "Turn it on or off for the desktop you're on from Bower's menu: Use Bower on This Desktop.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte es für deinen aktuellen Schreibtisch im Bower-Menü ein oder aus: Bower auf diesem Schreibtisch verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actívalo o desactívalo para el escritorio en el que estás desde el menú de Bower: Usar Bower en este escritorio."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای همین دسکتاپی که روشی، از منوی Bower روشن یا خاموشش کن: «Bower رو تو این دسکتاپ استفاده کن»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez-le ou désactivez-le pour le bureau actuel depuis le menu de Bower : Utiliser Bower sur ce bureau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attivalo o disattivalo per la scrivania in cui sei dal menu di Bower: Usa Bower su questa scrivania."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今いるデスクトップでのオン/オフは、Bowerのメニューの「このデスクトップでBowerを使用」で切り替えます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative ou desative para a mesa em que você está no menu do Bower: Usar o Bower Nesta Mesa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Bower 菜单中为当前桌面开启或关闭：在此桌面上使用 Bower。"
          }
        }
      }
    },
    "Turn it on or off for the desktop you're on in Bower's menu › This Display.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für den aktuellen Schreibtisch ein- oder ausschalten: Bowers Menü › Dieses Display."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actívalo o desactívalo para el escritorio actual en el menú de Bower › Esta pantalla."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "از منوی Bower › این نمایشگر، برای دسکتاپی که روش هستی روشن یا خاموشش کن."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez-le ou désactivez-le pour le bureau actuel dans le menu de Bower › Cet écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attivalo o disattivalo per la scrivania attuale dal menu di Bower › Questo schermo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bowerのメニュー › このディスプレイで、現在のデスクトップでのオン/オフを切り替えます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative ou desative para a mesa atual no menu do Bower › Esta Tela."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Bower 的菜单 › 此显示器中，为当前桌面开启或关闭。"
          }
        }
      }
    },
    "Turn off what gets in the way": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausschalten, was stört"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva lo que estorba"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "چیزایی که سر راهن رو خاموش کن"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactiver ce qui gêne"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattiva ciò che intralcia"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "邪魔になるものをオフにする"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
