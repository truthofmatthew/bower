    "Give every project its own desk, and switch the whole desk with ⌥1–9.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib jedem Projekt einen eigenen Schreibtisch und wechsle den ganzen Schreibtisch mit ⌥1–9."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dale a cada proyecto su propio escritorio y cámbialo entero con ⌥1–9."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به هر پروژه یه میز جدا بده و کل میز رو با ⁦⌥1–9⁩ عوض کن."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donnez à chaque projet son propre bureau et changez tout le bureau avec ⌥1–9."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dai a ogni progetto la sua scrivania e cambiala tutta con ⌥1–9."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロジェクトごとにデスクを用意して、⌥1–9でデスク全体を切り替えます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
