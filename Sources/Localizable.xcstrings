        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nascondi posizione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スロットを非表示"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar Posição"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏槽位"
          }
        }
      }
    },
    "Hide windows not in layout": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenster außerhalb des Layouts ausblenden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar ventanas fuera de la disposición"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پنجره‌های بیرون از چیدمان رو پنهان کن"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquer les fenêtres hors disposition"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nascondi le finestre fuori dal layout"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レイアウト外のウインドウを隠す"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar janelas fora do layout"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏不在布局中的窗口"
          }
        }
      }
    },
    "Hide windows that aren't in the current layout": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenster ausblenden, die nicht im aktuellen Layout sind"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar las ventanas que no están en la disposición actual"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پنجره‌هایی که تو چیدمان فعلی نیستن رو پنهان کن"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquer les fenêtres qui ne sont pas dans la disposition actuelle"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nascondi le finestre che non fanno parte del layout attuale"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のレイアウトにないウインドウを隠す"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar janelas que não estão no layout atual"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏不在当前布局中的窗口"
          }
        }
      }
    },
    "Hides every other app, so only this one stays.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blendet alle anderen Apps aus, nur diese bleibt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta las demás apps; solo queda esta."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بقیه‌ی برنامه‌ها رو پنهان می‌کنه تا فقط همین یکی بمونه."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masque toutes les autres apps ; seule celle-ci reste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasconde tutte le altre app; resta solo questa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのアプリをすべて隠し、このアプリだけを残します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta todos os outros apps; só este fica."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏其他所有应用，只保留这一个。"
          }
        }
      }
    },
    "Hold over a target": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über einem Ziel halten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener sobre un destino"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "روی هدف نگه دار"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenir sur une cible"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni sopra una destinazione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターゲットの上で待つ"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segurar sobre um destino"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在目标上停留"
          }
        }
      }
    },
    "Hold the modifiers and press a number from 1 to 9.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte die Sondertasten und drücke eine Zahl von 1 bis 9."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsados los modificadores y pulsa un número del 1 al 9."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کلیدهای تغییردهنده رو نگه دار و یه عدد از 1 تا 9 بزن."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez les touches de modification et appuyez sur un chiffre de 1 à 9."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuti i modificatori e premi un numero da 1 a 9."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "修飾キーを押したまま、1〜9の数字を押します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure os modificadores e pressione um número de 1 a 9."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住修饰键并按 1 到 9 的数字。"
          }
        }
      }
    },
    "Hold ⌘⇧ and drag a rectangle around a few windows. They expand to fill the screen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte ⌘⇧ und zieh ein Rechteck um ein paar Fenster. Sie breiten sich über den ganzen Bildschirm aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén ⌘⇧ y arrastra un rectángulo alrededor de unas ventanas. Se expanden hasta llenar la pantalla."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "⁦⌘⇧⁩ رو نگه دار و دور چندتا پنجره یه مستطیل بکش. گسترش پیدا می‌کنن تا کل صفحه رو بگیرن."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez ⌘⇧ et tracez un rectangle autour de quelques fenêtres. Elles se déploient pour remplir l’écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto ⌘⇧ e trascina un rettangolo attorno ad alcune finestre. Si espandono fino a riempire lo schermo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘⇧を押しながら、いくつかのウインドウを囲むように矩形をドラッグします。それらが画面いっぱいに展開されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure ⌘⇧ e arraste um retângulo em volta de algumas janelas. Elas se expandem para preencher a tela."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 ⌘⇧ 并围绕几个窗口拖出矩形。它们会展开并填满屏幕。"
          }
        }
      }
    },
    "Hold ⌥ and pan with two fingers to move to the neighbouring window.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte ⌥ und schiebe mit zwei Fingern, um zum Nachbarfenster zu wechseln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén ⌥ y desplázate con dos dedos para ir a la ventana vecina."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "‏⁦⌥⁩ رو نگه دار و با دو انگشت جابه‌جا کن تا بری سراغ پنجره‌ی بغلی."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez ⌥ et faites glisser deux doigts pour passer à la fenêtre voisine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto ⌥ e scorri con due dita per passare alla finestra vicina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥を押したまま2本指でパンすると、隣のウインドウに移動します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure ⌥ e desloque com dois dedos para ir até a janela vizinha."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 ⌥ 并用双指平移，可移到相邻窗口。"
          }
        }
      }
    },
    "Hold ⌥ and press a number from 1 to 9. Each layout keeps its own windows.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte ⌥ und drücke eine Zahl von 1 bis 9. Jedes Layout behält seine eigenen Fenster."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén ⌥ y pulsa un número del 1 al 9. Cada disposición conserva sus propias ventanas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "‏⁦⌥⁩ رو نگه دار و یه عدد از 1 تا 9 بزن. هر چیدمان پنجره‌های خودش رو نگه می‌داره."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez ⌥ et appuyez sur un chiffre de 1 à 9. Chaque disposition garde ses propres fenêtres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto ⌥ e premi un numero da 1 a 9. Ogni layout mantiene le sue finestre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥を押したまま1〜9の数字を押します。レイアウトごとにウインドウが保持されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure ⌥ e pressione um número de 1 a 9. Cada layout mantém suas próprias janelas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 ⌥ 并按 1 到 9 的数字。每个布局保留自己的窗口。"
          }
        }
      }
    },
    "How fast windows move and fade. With Reduce Motion on in System Settings › Accessibility › Display, windows go straight to where they're going.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie schnell Fenster sich bewegen und ausblenden. Ist „Bewegung reduzieren“ in Systemeinstellungen › Bedienungshilfen › Anzeige an, springen Fenster direkt an ihr Ziel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo rápido que se mueven y se desvanecen las ventanas. Con Reducir movimiento activado en Ajustes del Sistema › Accesibilidad › Pantalla, las ventanas van directamente a su destino."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پنجره‌ها با چه سرعتی جابه‌جا و محو می‌شن. اگه Reduce Motion تو System Settings › Accessibility › Display روشن باشه، پنجره‌ها یه‌راست می‌رن سر جاشون."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vitesse à laquelle les fenêtres se déplacent et s’estompent. Avec Réduire les animations activé dans Réglages Système › Accessibilité › Affichage, les fenêtres vont directement à leur place."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto velocemente le finestre si spostano e svaniscono. Con Riduci movimento attivo in Impostazioni di Sistema › Accessibilità › Schermo, le finestre vanno direttamente a destinazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウの移動とフェードの速さです。システム設定 › アクセシビリティ › ディスプレイで「視差効果を減らす」がオンのときは、ウインドウは移動先に直接移ります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A velocidade com que as janelas se movem e esmaecem. Com Reduzir movimento ativado em Ajustes do Sistema › Acessibilidade › Tela, as janelas vão direto para o destino."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口移动和淡入淡出的速度。若在系统设置 › 辅助功能 › 显示中打开了“减弱动态效果”，窗口会直接到位。"
          }
        }
      }
    },
    "How long before the layout makes room. Letting go drops it there at once.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie lange es dauert, bis das Layout Platz macht. Beim Loslassen landet es sofort dort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto tarda la disposición en hacer sitio. Al soltar, la ventana se coloca ahí al instante."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "چقدر طول بکشه تا چیدمان جا باز کنه. اگه ول کنی، همون لحظه همون‌جا می‌افته."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le délai avant que la disposition fasse de la place. Relâcher la dépose là immédiatement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto attendere prima che il layout faccia spazio. Rilasciando, la finestra viene messa lì subito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レイアウトが場所を空けるまでの時間です。離すとすぐにそこに置かれます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto tempo até o layout abrir espaço. Soltar deixa a janela ali na hora."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "布局腾出空间前的等待时间。松开会立即放在那里。"
          }
        }
      }
    },
    "How white the frame round Bower's menu bar buttons is.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie weiß der Rahmen um Bowers Menüleistentasten ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo blanco que es el marco de los botones de Bower en la barra de menús."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "قاب دور دکمه‌های Bower تو نوار منو چقدر سفید باشه."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La blancheur du cadre autour des boutons de Bower dans la barre des menus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto è bianca la cornice attorno ai pulsanti di Bower nella barra dei menu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bowerのメニューバーボタンを囲む枠の白さです。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O quão branca é a moldura dos botões do Bower na barra de menus."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Bower 菜单栏按钮周围边框的白度。"
          }
        }
      }
    },
    "ISO uses ⌃⌥< (the key left of Z) for Center Third.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ISO-Tastaturen verwenden ⌃⌥< (die Taste links neben Y) für „Mittleres Drittel“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En teclados ISO, Tercio central usa ⌃⌥< (la tecla a la izquierda de la Z)."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "رو کیبورد ISO، برای یک‌سوم وسط ⁦⌃⌥<⁩ رو بزن (کلید سمت چپ Z)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le clavier ISO utilise ⌃⌥< (la touche à gauche de W en AZERTY) pour Tiers central."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sulle tastiere ISO, Terzo centrale usa ⌃⌥< (il tasto a sinistra di Z)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ISOキーボードでは、中央の3分の1に⌃⌥<（Zの左のキー）を使います。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "ISO usa ⌃⌥< (a tecla à esquerda do Z) para Terço Central."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ISO 键盘使用 ⌃⌥<（Z 左侧的键）表示中间三分之一。"
          }
        }
      }
    },
    "Icon only": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Symbol"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo icono"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط آیکون"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Icône seule"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo icona"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイコンのみ"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas ícone"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅图标"
          }
        }
      }
    },
    "If the endpoint needs one": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Falls der Endpunkt einen braucht"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si el endpoint la necesita"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اگه سرور لازمش داره"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si le point de terminaison en a besoin"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se l'endpoint ne richiede una"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エンドポイントで必要な場合"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o endpoint precisar de uma"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果端点需要"
          }
        }
      }
    },
    "If they open again, they're placed as new windows.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn sie wieder geöffnet werden, werden sie wie neue Fenster platziert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vuelven a abrirse, se colocan como ventanas nuevas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اگه دوباره باز شن، مثل پنجره‌ی جدید چیده می‌شن."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si elles se rouvrent, elles sont placées comme de nouvelles fenêtres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se si riaprono, vengono posizionate come nuove finestre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再び開いた場合は、新しいウインドウとして配置されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se abrirem de novo, serão posicionadas como janelas novas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果它们再次打开，会作为新窗口放置。"
          }
        }
      }
    },
    "In Dock mode windows sit side by side and never overlap. Turn it on for a display in Bower's menu › This Display, then drag a title bar to another window's edge to dock it there.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Dock-Modus liegen Fenster nebeneinander und überlappen sich nie. Schalte ihn für ein Display in Bowers Menü › Dieses Display ein und zieh dann eine Titelleiste an den Rand eines anderen Fensters, um es dort anzudocken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el modo Dock las ventanas se colocan una al lado de otra y nunca se superponen. Actívalo para una pantalla en el menú de Bower › Esta pantalla y luego arrastra una barra de título al borde de otra ventana para acoplarla ahí."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تو حالت داک پنجره‌ها کنار هم می‌شینن و هیچ‌وقت رو هم نمی‌افتن. از منوی Bower › این نمایشگر برای یه نمایشگر روشنش کن، بعد نوار عنوان یه پنجره رو بکش ببر لبه‌ی یه پنجره‌ی دیگه تا همون‌جا داک بشه."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En mode Dock, les fenêtres se placent côte à côte sans jamais se chevaucher. Activez-le pour un écran dans le menu de Bower › Cet écran, puis faites glisser une barre de titre sur le bord d’une autre fenêtre pour l’y docker."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In modalità Dock le finestre stanno una accanto all'altra e non si sovrappongono mai. Attivala per uno schermo dal menu di Bower › Questo schermo, poi trascina una barra del titolo sul bordo di un'altra finestra per ancorarla lì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドックモードでは、ウインドウは横に並び、重なることはありません。Bowerのメニュー › このディスプレイでディスプレイごとにオンにし、タイトルバーを別のウインドウの端にドラッグするとそこにドッキングします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No modo Dock, as janelas ficam lado a lado e nunca se sobrepõem. Ative-o para uma tela no menu do Bower › Esta Tela e arraste uma barra de título até a borda de outra janela para acoplá-la ali."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在停靠模式下，窗口并排排列，绝不重叠。在 Bower 的菜单 › 此显示器中为显示器开启它，然后将标题栏拖到另一个窗口的边缘，即可停靠在那里。"
          }
        }
      }
    },
    "Inset": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eingelassen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Margen interior"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تورفتگی"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Encastré"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rientro"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インセット"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Recuo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内嵌"
          }
        }
      }
    },
    "Instead of full screen. fn-click still goes full screen, and ⌥-click zooms.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Statt Vollbild. fn-Klick wechselt weiterhin ins Vollbild, ⌥-Klick zoomt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En lugar de pantalla completa. fn-clic sigue activando la pantalla completa y ⌥-clic hace zoom."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به جای فول‌اسکرین. fn-کلیک هنوزم فول‌اسکرین می‌کنه، و ⁦⌥⁩-کلیک زوم."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au lieu du plein écran. fn-clic passe toujours en plein écran, et ⌥-clic zoome."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invece di passare a tutto schermo. fn-clic passa ancora a tutto schermo e ⌥-clic esegue lo zoom."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フルスクリーンの代わりに。fn-クリックでは従来どおりフルスクリーン、⌥-クリックでズームします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em vez de tela cheia. fn-clique ainda entra em tela cheia, e ⌥-clique aplica zoom."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "替代全屏幕。按住 fn 点按仍会进入全屏幕，按住 ⌥ 点按则缩放。"
          }
        }
      }
    },
    "It keeps its windows when you switch layouts on other displays. Click to unpin.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es behält seine Fenster, wenn du auf anderen Displays das Layout wechselst. Zum Lösen klicken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva sus ventanas cuando cambias de disposición en otras pantallas. Haz clic para dejar de fijarla."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "وقتی رو نمایشگرهای دیگه چیدمان رو عوض می‌کنی، پنجره‌هاش سر جاشون می‌مونن. کلیک کن تا سنجاقش رو برداری."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il garde ses fenêtres quand vous changez de disposition sur d’autres écrans. Cliquez pour le désépingler."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene le sue finestre quando cambi layout sugli altri schermi. Fai clic per sbloccarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのディスプレイでレイアウトを切り替えても、ウインドウはそのまま残ります。クリックで固定解除します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ela mantém suas janelas quando você troca de layout em outras telas. Clique para desafixar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在其他显示器上切换布局时，它会保留其窗口。点按以取消固定。"
          }
        }
      }
    },
    "Its swipe and keyboard shortcut show every window, where it is in your layouts; click one to go to it. Opened another way (its Dock icon, a hot corner), Mission Control shows for a moment first. Hold fn as you swipe for Mission Control itself.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seine Streichgeste und sein Tastaturkurzbefehl zeigen jedes Fenster dort, wo es in deinen Layouts ist; klicke auf eines, um dorthin zu gehen. Anders geöffnet (über das Dock-Symbol, eine aktive Ecke) erscheint zuerst kurz Mission Control. Halte beim Streichen fn für Mission Control selbst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su gesto y su atajo de teclado muestran todas las ventanas, donde están en tus disposiciones; haz clic en una para ir a ella. Si se abre de otra forma (su icono del Dock, una esquina activa), Mission Control aparece un momento antes. Mantén fn al deslizar para el propio Mission Control."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سوایپ و میان‌بر کیبوردش همه‌ی پنجره‌ها رو همون‌جایی که تو چیدمان‌هات هستن نشون می‌ده؛ رو یکی کلیک کن تا بری سراغش. اگه از راه دیگه باز شه (آیکونش تو Dock، یه Hot Corner)، اول یه لحظه Mission Control میاد. برای خود Mission Control، موقع سوایپ fn رو نگه دار."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son balayage et son raccourci clavier montrent chaque fenêtre là où elle se trouve dans vos dispositions ; cliquez sur l’une d’elles pour y aller. Ouvert autrement (son icône dans le Dock, un coin actif), Mission Control s’affiche d’abord un instant. Maintenez fn en balayant pour Mission Control lui-même."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il suo scorrimento e la sua abbreviazione da tastiera mostrano tutte le finestre, dove si trovano nei tuoi layout; fai clic su una per andarci. Se la apri in un altro modo (la sua icona nel Dock, un angolo attivo), Mission Control appare prima per un attimo. Tieni premuto fn mentre scorri per Mission Control vero e proprio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスワイプとキーボードショートカットで、すべてのウインドウをレイアウト内の位置のまま表示します。クリックするとそのウインドウに移動します。ほかの方法（Dockアイコンやホットコーナー）で開くと、先に一瞬Mission Controlが表示されます。Mission Control自体を使うには、fnを押したままスワイプします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O gesto e o atalho de teclado mostram todas as janelas, onde estão nos seus layouts; clique em uma para ir até ela. Aberto de outra forma (pelo ícone no Dock, um canto ativo), o Mission Control aparece por um instante antes. Segure fn ao deslizar para o próprio Mission Control."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它的轻扫手势和键盘快捷键会显示所有窗口及其在布局中的位置；点按一个即可前往。通过其他方式打开（程序坞图标、触发角）时，会先短暂显示调度中心。轻扫时按住 fn 可使用调度中心本身。"
          }
        }
      }
    },
    "Keep Learning": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weiterlernen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seguir aprendiendo"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ادامه‌ی یادگیری"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuer à apprendre"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua a imparare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "さらに学ぶ"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuar Aprendendo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续学习"
          }
        }
      }
    },
    "Keep going with tab groups, expanding to a rectangle and more, the same way. Or stop here: Bower's menu › Help brings this back.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach auf die gleiche Weise mit Tab-Gruppen, Ausbreiten auf ein Rechteck und mehr weiter. Oder hör hier auf: Bower-Menü › Hilfe holt das zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue con los grupos de pestañas, expandir a un rectángulo y más, de la misma forma. O para aquí: menú de Bower › Ayuda lo vuelve a mostrar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همین‌طوری با گروه زبانه‌ها، گسترش به یه مستطیل و چیزای دیگه ادامه بده. یا همین‌جا تمومش کن: منوی Bower › راهنما دوباره اینو میاره."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuez de la même façon avec les groupes d’onglets, le déploiement d’un rectangle et plus encore. Ou arrêtez-vous ici : menu de Bower › Aide le rouvre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua con i gruppi di pannelli, l’espansione di un rettangolo e altro, allo stesso modo. Oppure fermati qui: menu di Bower › Aiuto lo riapre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブグループや矩形への展開なども、同じように続けて学べます。ここで終えても、Bowerのメニュー › ヘルプでいつでもまた表示できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue com grupos de abas, expandir para um retângulo e mais, do mesmo jeito. Ou pare aqui: menu do Bower › Ajuda traz isto de volta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用同样的方式继续了解标签页组、展开到矩形等功能。或者就此停下：Bower 菜单 › 帮助可再次打开此内容。"
          }
        }
      }
    },
    "Keep its space empty": {
