            "state": "translated",
            "value": "Desativado: o botão do meio vai para os apps normalmente."
          }
        }
      }
    },
    "Off: windows from other layouts stay where they are, behind.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus: Fenster aus anderen Layouts bleiben, wo sie sind – im Hintergrund."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado: las ventanas de otras disposiciones se quedan donde están, detrás."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "خاموش: پنجره‌های چیدمان‌های دیگه همون پشت، سر جاشون می‌مونن."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé : les fenêtres des autres dispositions restent où elles sont, en arrière-plan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivato: le finestre degli altri layout restano dove sono, sullo sfondo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフ：ほかのレイアウトのウインドウは背面のその場所に残ります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
