    "Three fingers": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drei Finger"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tres dedos"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سه انگشت"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trois doigts"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tre dita"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3本指"
          }
        },
        "pt-BR": {
          "stringUnit": {
