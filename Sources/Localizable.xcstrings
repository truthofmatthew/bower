    "%@, too small to show. Double-click to open it on its own.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, zu klein zum Anzeigen. Doppelklicke, um es einzeln zu öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, demasiado pequeña para mostrarse. Haz doble clic para abrirla sola."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "‏⁨%@⁩، اون‌قدر کوچیکه که دیده نمی‌شه. دوبار کلیک کن تا تکی ببینیش."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, trop petite pour être affichée. Double-cliquez pour l’ouvrir seule."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, troppo piccola per essere mostrata. Fai doppio clic per aprirla da sola."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@、小さすぎて表示できません。ダブルクリックすると単独表示します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, pequena demais para mostrar. Clique duas vezes para abri-la sozinha."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，太小无法显示。连按即可单独打开。"
          }
        }
      }
    },
