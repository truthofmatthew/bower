    "%@ is on the wheel. Drag it to move it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist auf dem Snap-Rad. Zum Verschieben ziehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está en la rueda. Arrástralo para moverlo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "‏⁨%@⁩ روی چرخه. بکشش تا جابه‌جا شه."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est sur la roue. Faites-le glisser pour le déplacer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è sulla ruota. Trascinala per spostarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はホイール上にあります。ドラッグして移動できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está na roda. Arraste para movê-la."
          }
        }
      }
    },
