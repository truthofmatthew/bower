    "⌘⇧-drag a rectangle to expand what it frames": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit ⌘⇧ ein Rechteck ziehen, um auszubreiten, was es umschließt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra un rectángulo con ⌘⇧ para expandir lo que encuadra"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با ⁦⌘⇧⁩ یه مستطیل بکش تا هرچی توشه گسترش پیدا کنه"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘⇧-glisser un rectangle pour déployer ce qu’il entoure"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina un rettangolo con ⌘⇧ per espandere ciò che racchiude"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘⇧-ドラッグで矩形を描き、囲んだ部分を展開"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste um retângulo com ⌘⇧ para expandir o que ele enquadra"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 ⌘⇧ 拖出矩形以展开框住的内容"
          }
        }
      }
    },
