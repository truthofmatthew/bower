    "Name a layout for each project and switch the whole desk with ⌥1–9.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benenne ein Layout für jedes Projekt und wechsle den ganzen Schreibtisch mit ⌥1–9."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon nombre a una disposición para cada proyecto y cambia todo el escritorio con ⌥1–9."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای هر پروژه یه چیدمان بساز و کل میزت رو با ⁦⌥1–9⁩ عوض کن."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nommez une disposition pour chaque projet et changez tout le bureau avec ⌥1–9."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dai un nome a un layout per ogni progetto e cambia l'intera scrivania con ⌥1–9."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロジェクトごとにレイアウトに名前を付け、⌥1–9でデスク全体を切り替えます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dê nome a um layout para cada projeto e troque a mesa inteira com ⌥1–9."
          }
        }
      }
    },
