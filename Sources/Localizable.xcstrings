    "Pinch out to expand toward your window; pinch in to go back a level or see everything.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auseinanderziehen breitet zu deinem Fenster hin aus; zusammenziehen geht eine Ebene zurück oder zeigt alles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Separa los dedos para expandir hacia tu ventana; júntalos para volver un nivel o verlo todo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "انگشت‌ها رو باز کن تا سمت پنجره‌ات گسترش بده؛ جمع کن تا یه سطح برگردی یا همه‌چی رو ببینی."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écartez pour déployer vers votre fenêtre ; pincez pour revenir d’un niveau ou tout voir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Allontana le dita per espandere verso la tua finestra; avvicinale per tornare indietro di un livello o vedere tutto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピンチアウトで操作中のウインドウに向けて展開。ピンチインで1レベル戻るか、すべてを表示。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Afaste os dedos para expandir em direção à sua janela; junte-os para voltar um nível ou ver tudo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双指张开可朝当前窗口展开；双指捏合可返回一级或查看全部。"
          }
        }
      }
    },
    "Pinch to expand": {
