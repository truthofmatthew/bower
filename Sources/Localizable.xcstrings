    "Point at an action to see what it does.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeig auf eine Aktion, um zu sehen, was sie tut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Señala una acción para ver qué hace."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "موس رو ببر روی یه کار تا ببینی چی کار می‌کنه."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Survolez une action pour voir ce qu’elle fait."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Punta un’azione per vedere cosa fa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクションにポインタを合わせると動きを確認できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aponte para uma ação para ver o que ela faz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指向一个操作即可查看其作用。"
          }
        }
      }
    },
    "Preset": {
      "extractionState": "stale",
      "localizations": {
